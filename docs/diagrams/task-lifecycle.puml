@startuml task-lifecycle
' Marshal — Task lifecycle
'
' KEEP UP TO DATE: this diagram must match the task system, event bus,
' approval queue and task delivery (task-system, event-bus, approval-queue,
' task-delivery specs). Update it in the same change that alters them, and
' re-render the SVG (see docs/diagrams/README.md).

!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam state {
  BackgroundColor #FEFEFE
  BorderColor #555555
  ArrowColor #555555
}
hide empty description

title Marshal — Task lifecycle

state "pending" as Pending
state "waiting" as Waiting : at / cron / event / after / wakeup /\napproval decision
state "due" as Due : trigger fired\n(event filters matched\ndeterministically, no model call)
state "queued for a worker" as Queued : at most tasks.workers runs;\norder of next_run_at
state "running" as Running {
  state "headless agent loop" as Loop : owner, template, project,\norigin satellite policy,\nbackground tool rules,\nbudget + daily cost cap
  state "approval queued" as Approval : frozen action, nonce,\n10 min TTL, actionable push\n+ review queue
  Loop --> Approval : confirm-tier call
}
state "result" as Result : speech + body
state "deliveries" as Deliveries : voice / push / inbox / silent\nwhen-conditions, expires + fallback,\nquiet hours, coalescing, voice caps
state "done" as Done
state "failed" as Failed : budget_exceeded, errors
state "cancelled" as Cancelled : tasks.cancel, kill switch

[*] --> Pending : tasks.create / tasks.watch /\nfile / system / backgrounded turn
Pending --> Waiting : future trigger
Pending --> Due : trigger now
Waiting --> Due : time reached, matching event,\nparent done, decision made
Due --> Queued
Queued --> Running : worker free
Approval --> Waiting : run ends, worker freed\n(trigger = decision)
Loop --> Waiting : new trigger (wakeup);\nnext run gets goal, notes,\npayload, no transcript
Loop --> Result : final reply
Loop --> Failed : budget / limits
Result --> Deliveries
Deliveries --> Waiting : cron, or watch without once
Deliveries --> Done : once-watch and other triggers
Running --> Cancelled
Waiting --> Cancelled
Done --> [*]
Failed --> [*]
Cancelled --> [*]
@enduml
