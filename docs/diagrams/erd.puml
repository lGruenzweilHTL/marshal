@startuml erd
' Marshal — Entity Relationship Diagram
'
' KEEP UP TO DATE: this diagram must match the EF Core model in src/.
' Update it in the same change that adds, removes or renames an entity,
' column or relationship, and re-render the SVG (see docs/diagrams/README.md).
'
' Status: PARTLY BUILT — User (+ Identity tables), AuthTicket, UserPreferences, ApiToken, Session,
' Run, RunStep, PendingAction, FollowUp, AuditEvent, Secret, MailAccount, NoteIndexEntry, the Memory package and the
' Background Work package exist in Marshal.Data; the other entities are still planned (docs/brainstorm-notes.md).

!pragma layout smetana
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #555555
  HeaderBackgroundColor #E8EEF7
}

title Marshal — ERD (planned)

' ------------------------------------------------------------------
package "Identity & Access" {
  entity User <<Identity: users>> {
    * id : OwnerId <<PK, Identity key (IdentityUser<OwnerId>)>>
    --
    user_name : string
    normalized_user_name : string  <<unique>>
    email : string
    normalized_email : string
    * email_confirmed : bool
    password_hash : string  <<local only>>
    security_stamp : string
    concurrency_stamp : string
    phone_number : string
    * phone_number_confirmed : bool
    * two_factor_enabled : bool
    lockout_end : DateTimeOffset
    * lockout_enabled : bool
    * access_failed_count : int
    * display_name : string
    * created_at : DateTimeOffset
  }

  entity UserLogin <<Identity: user_logins>> {
    * login_provider : string <<PK>>
    * provider_key : string <<PK, OIDC sub>>
    --
    * user_id : OwnerId <<FK>>
    provider_display_name : string
  }

  entity UserPasskey <<Identity: user_passkeys>> {
    * credential_id : bytes <<PK>>
    --
    * user_id : OwnerId <<FK>>
    * data : json  <<public key, sign count, name>>
  }

  entity Role <<Identity: roles>> {
    * id : OwnerId-typed <<PK, Identity shares the key type>>
    --
    name : admin | user
    normalized_name : string  <<unique>>
    concurrency_stamp : string
  }

  entity UserRole <<Identity: user_roles>> {
    * user_id : OwnerId <<PK, FK>>
    * role_id : Role id <<PK, FK>>
  }

  entity UserClaim <<Identity: user_claims>> {
    * id : int <<PK>>
    --
    * user_id : OwnerId <<FK>>
    claim_type : string
    claim_value : string
  }

  entity UserToken <<Identity: user_tokens>> {
    * user_id : OwnerId <<PK, FK>>
    * login_provider : string <<PK>>
    * name : string <<PK>>
    --
    value : string
  }

  entity RoleClaim <<Identity: role_claims>> {
    * id : int <<PK>>
    --
    * role_id : Role id <<FK>>
    claim_type : string
    claim_value : string
  }

  entity ApiToken {
    * id : ApiTokenId <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * name : string
    * token_hash : string  <<unique, SHA-256 hex>>
    * scopes : string[]
    * kind : standard | executor_callback
    task_id : TaskId <<FK>>
    * created_at : DateTimeOffset
    expires_at : DateTimeOffset
    revoked_at : DateTimeOffset
  }

  entity AuthTicket {
    * id : string <<PK, SHA-256 hex of the cookie key>>
    --
    * owner_id : OwnerId <<FK>>
    * value : bytes  <<serialized ticket incl. IdP tokens, Data Protection>>
    * created_at : DateTimeOffset
    expires_at : DateTimeOffset
  }

  entity UserPreferences {
    * user_id : OwnerId <<PK, FK>>
    --
    * language : de | en
    * time_zone : string  <<IANA, default from HA>>
    quiet_hours : json
    notification_targets : json
    dnd_until : DateTimeOffset
    tasks_paused_at : DateTimeOffset  <<kill switch active>>
  }
}

' ------------------------------------------------------------------
package "Conversations & Runs" {
  entity Session {
    * id : SessionId <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * source : voice | web | task | api
    api_token_id : ApiTokenId <<FK, null for web / task>>
    external_id : string  <<client conversation id>>
    * identity_evidence : json
    * resolved_by : string
    * created_at : DateTimeOffset
    * last_turn_at : DateTimeOffset
    closed_at : DateTimeOffset
    <<unique (api_token_id, external_id) where closed_at is null>>
  }

  entity Run {
    * id : RunId <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    session_id : SessionId <<FK>>
    task_id : TaskId <<FK>>
    * source : voice | web | task | api
    input_mode : voice | text
    satellite_id : string
    area_id : string
    language : string
    * trigger : string
    * started_at : DateTimeOffset
    ended_at : DateTimeOffset
    * outcome : ok | error | backgrounded | cancelled
    outcome_reason : string  <<e.g. latency_cap>>
    * tainted : bool  <<untrusted content entered context>>
    taint_sources : json  <<mail | rss | notes | web | mcp:<id>, first tainting step>>
    * cost : decimal
  }

  entity RunStep {
    * id : Guid <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * run_id : RunId <<FK>>
    * sequence : int
    * kind : context | model_call | tool_call | reply
    model : string
    tier : string
    tokens_in / tokens_out / tokens_cached : int
    first_token_ms : int
    tool : string
    risk_tier : string
    guard_decision : string
    payload : json  <<redacted, 30 d>>
    * duration_ms : int
    cost : decimal
    error : string
    * depth : int  <<0 = run, 1+ = subagent>>
  }

  entity PendingAction {
    * id : PendingActionId <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    session_id : SessionId <<FK>>
    task_id : TaskId <<FK>>
    satellite_id : string  <<frozen with the action>>
    run_id : RunId  <<run that asked; no FK (retention)>>
    * taint : json  <<[{kind, firstStep}] of that run>>
    * tool : string
    * args : json  <<frozen>>
    * summary : string
    * reasons : json  <<[{code: rule | unresolved_target | taint | quiet_hours_override, detail}]>>
    * nonce : string  <<unique>>
    * language : de | en  <<language of the reason sentences>>
    * created_at : DateTimeOffset
    * expires_at : DateTimeOffset  <<~60 s conversation, 10 min approval queue>>
    * status : pending | approved | rejected | dropped | expired | superseded
    decided_by : keyword | judge | ui | push | system
    decided_at : DateTimeOffset
  }

  entity FollowUp {
    * id : Guid <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * nonce : string  <<unique, sent as extra_system_prompt>>
    * satellite_id : string
    pending_action_id : PendingActionId <<FK>>
    task_id : TaskId <<FK>>
    linked_session_id : SessionId <<FK>>
    * created_at : DateTimeOffset  <<reply window starts here>>
    * expires_at : DateTimeOffset
    consumed_at : DateTimeOffset
  }

  entity AuditEvent {
    * id : Guid <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * actor_kind : user | api_token | system
    actor_id : string
    run_id : RunId <<FK>>
    * action : string  <<e.g. printer.pause, approval.approve>>
    target : string
    details : json
    * created_at : DateTimeOffset
  }
}

' ------------------------------------------------------------------
package "Memory" {
  entity Project {
    * id : ProjectId <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * name : string
    * description : string
    centroid : blob  <<float32 vector>>
    last_active_at : DateTimeOffset
    * created_at : DateTimeOffset
    deleted_at : DateTimeOffset  <<soft delete>>
  }

  entity ProjectFeedback {
    * id : Guid <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * project_id : ProjectId <<FK>>
    run_id : RunId <<FK>>
    * kind : confirmed | rejected | switched
    * phrase : string
    embedding : blob  <<float32 vector, negative examples>>
    * created_at : DateTimeOffset
  }

  entity ProjectAlias {
    * id : Guid <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * project_id : ProjectId <<FK, unique with phrase>>
    * phrase : string
    * status : candidate | active | rejected
    * confirmations : int
    * created_at : DateTimeOffset
  }

  entity Chunk {
    * id : ChunkId <<PK, hash(owner_id + scope + project_id + type + normalized title)>>
    --
    * owner_id : OwnerId <<FK>>
    project_id : ProjectId <<FK, set iff scope = project>>
    * scope : general | project
    * type : fact | preference | event | procedure | person | device
    * title : string
    * content : string
    * importance : int (1-5)
    * pinned : bool
    source_ref : string  <<e.g. note path>>
    * created_by : user | agent | consolidation | import
    * created_at : DateTimeOffset
    * updated_at : DateTimeOffset
    deleted_at : DateTimeOffset  <<soft delete>>
    last_retrieved_at : DateTimeOffset
  }

  entity ChunkVersion {
    * id : Guid <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * chunk_id : ChunkId <<FK>>
    * content : string
    * importance : int (1-5)
    source_ref : string
    * replaced_at : DateTimeOffset
    <<previous content of a same-id update>>
  }

  entity ChunkEdge {
    * from_id : ChunkId <<PK, FK>>
    * to_id : ChunkId <<PK, FK>>
    * kind : supersedes | contradicts | depends_on | relates_to <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * created_at : DateTimeOffset
    <<no self-supersede (check)>>
  }

  entity "chunks_fts" as ChunkFts <<FTS5>> {
    chunk_id, owner_id : unindexed
    title, content : indexed
  }

  entity "chunk_vectors" as ChunkVectors <<sqlite-vec vec0>> {
    * chunk_id : text <<PK>>
    * owner_id : text <<partition key>>
    * embedding : float[N] <<cosine, N from the embedding model>>
  }
}

' ------------------------------------------------------------------
package "Background Work" {
  entity AgentTask <<agent_tasks>> {
    * id : TaskId <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    parent_id : TaskId <<FK>>
    * created_by : user | task | system
    * kind : agent | system
    * goal : string
    job : string  <<registered job of a system task>>
    template : string
    project_id : ProjectId <<FK>>
    origin_satellite_id : string  <<policy applies to all runs + children>>
    * trigger_kind : now | at | cron | event | after
    * trigger_spec : string  <<time, cron, event filter json or task id>>
    trigger_payload : json  <<handed to the next run>>
    * status : pending | running | waiting | done | failed | cancelled
    status_reason : string  <<e.g. budget_exceeded>>
    next_run_at : DateTimeOffset
    notes : string
    * budget : json
    * spent : json
    name : string  <<unique (owner_id, name) where name is not null>>
    * deliveries : json  <<[{channel, target, priority, followUp, when, expires, fallback, pendingSince, expiresAt}]>>
    * deliveries_pending : bool  <<a delivery waits for its conditions>>
    override_quiet_hours_until : DateTimeOffset
    result_speech : string
    result_body : string  <<markdown>>
    result_at : DateTimeOffset
    * depth : int
    * created_at : DateTimeOffset
    * updated_at : DateTimeOffset
    * row_version : long  <<optimistic concurrency>>
  }

  entity ExecutorSession {
    * id : Guid <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * task_id : TaskId <<FK>>
    * executor : string
    * handle : string
    target : string  <<e.g. repository>>
    callback_token_id : ApiTokenId <<FK, unique>>
    * status : starting | running | done | failed | cancelled
    * started_at : DateTimeOffset
    finished_at : DateTimeOffset
  }

  entity Notification {
    * id : Guid <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    task_id : TaskId <<FK>>
    * source : string
    * priority : critical | normal | low
    * content : string
    channel : string
    * outcome : pending | delivered | coalesced | held | inboxed | expired | fallback
    reason : string
    coalesced_into : Guid <<FK>>
    * routing : json  <<requested channel, target, link, actions, ...>>
    deliver_after : DateTimeOffset  <<held or coalescing until>>
    * created_at : DateTimeOffset
    delivered_at : DateTimeOffset
    consumed_at : DateTimeOffset  <<inbox item read by a task>>
  }


  entity Proposal {
    * id : Guid <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    task_id : TaskId <<FK>>
    * kind : notes | code
    * target : string  <<repo / sink>>
    * branch : string
    * title : string
    * diff : string  <<unified diff>>
    * status : open | merged | rejected
    * created_at : DateTimeOffset
    decided_at : DateTimeOffset
  }
}

' ------------------------------------------------------------------
package "Integrations & Secrets" {
  entity Secret {
    * id : Guid <<PK>>
    --
    owner_id : OwnerId <<FK, null = instance>>
    * name : string
    * ciphertext : bytes  <<Data Protection>>
    * created_at : DateTimeOffset
    * updated_at : DateTimeOffset
    <<unique (name) where owner_id is null>>
    <<unique (owner_id, name) where owner_id is not null>>
  }

  entity MailAccount <<mail_accounts>> {
    * id : MailAccountId <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * alias : string  <<lowercase, unique per owner>>
    * provider : imap  <<graph | gmail later>>
    * strategy : password | o_auth_google | o_auth_microsoft
    * credential_secret : string  <<Secret.name, owner secret>>
    * host : string
    * port : int
    * security : tls | start_tls | none
    * user_name : string
    drafts_folder : string  <<when no folder has special-use Drafts>>
    * created_at : DateTimeOffset
    <<unique (owner_id, alias)>>
  }

  entity NoteIndexEntry <<note_index_entries>> {
    * id : Guid <<PK>>
    --
    * owner_id : OwnerId <<FK>>
    * path : string  <<relative to the notes repository>>
    * heading : string
    * position : int  <<section order in the file>>
    * text : string
    * file_hash : string  <<SHA-256 of the file when indexed>>
    * indexed_at : DateTimeOffset
    <<index (owner_id, path)>>
    <<derived, rebuilt per file on change>>
    <<keyword: notes_fts (FTS5), vector: note_vectors (sqlite-vec)>>
  }
}

