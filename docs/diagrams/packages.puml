@startuml packages
' Marshal — Package Diagram
'
' KEEP UP TO DATE: this diagram must match the projects in src/, web/, ha/,
' their project references and their key external packages. Update it in the
' same change that adds, removes or renames a project, changes a project
' reference or adds / removes a key package, and re-render the SVG
' (see docs/diagrams/README.md).
'
' Status: PARTLY BUILT — Marshal.Abstractions, Marshal.Core, Marshal.Data,
' Marshal.Api, Marshal.Testing and their test projects exist (core-agent);
' the other projects are still planned (docs/brainstorm-notes.md).
' External packages are drawn inside the project that references them
' (grey boxes, <<nuget>> / <<npm>> / <<pip>>).

!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FEFEFE
  BorderColor #555555
}
skinparam component<<nuget>> {
  BackgroundColor #EEEEEE
  BorderColor #999999
  FontColor #444444
}
skinparam component<<npm>> {
  BackgroundColor #EEEEEE
  BorderColor #999999
  FontColor #444444
}
skinparam component<<pip>> {
  BackgroundColor #EEEEEE
  BorderColor #999999
  FontColor #444444
}
hide stereotype

title Marshal — Packages (planned)

' ------------------------------------------------------------------
package "Clients" {
  package "ha/ custom_components/marshal (Python, HACS)" as HaComponent {
    component "pytest-homeassistant-\ncustom-component" <<pip>>
  }
  package "web/ (Vue SPA)" as Web {
    component "vue, vite, typescript" <<npm>>
    component "openapi-typescript\n+ openapi-fetch" <<npm>>
  }
  component "HA companion app\n(actionable push)" as Companion
}

package "src/ (.NET 10)" {
  package "Marshal.Api" as Api {
    component "ASP.NET host: REST + live updates\nunder /api/v1, versioned OpenAPI,\nBFF auth, API tokens, serves SPA,\ncomposition root" as ApiHost
    component "Asp.Versioning.Http\n+ Mvc.ApiExplorer\n+ Asp.Versioning.OpenApi" <<nuget>>
    component "Microsoft.AspNetCore.OpenApi" <<nuget>>
    component "Authentication.OpenIdConnect\nIdentity.EntityFrameworkCore" <<nuget>>
    component "NetEscapades\n.Configuration.Yaml" <<nuget>>
    component "OpenTelemetry.*\n(Extensions.Hosting,\nExporter.OpenTelemetryProtocol)" <<nuget>>
    component "OllamaSharp\nAnthropic (official SDK)\nMicrosoft.Extensions.AI.OpenAI" <<nuget>>
  }

  package "Marshal.Core" as Core {
    component "Agent loop, tool registry\n+ visibility, risk engine + guard,\ncontext builder, model router,\nsessions" as CoreParts
    component "Microsoft.Extensions.AI" <<nuget>>
    component "ModelContextProtocol" <<nuget>>
    component "YamlDotNet" <<nuget>>
  }

  package "Marshal.Memory" as Memory {
    component "Chunks + edges, hybrid retrieval,\nproject activation, consolidation" as MemoryParts
  }

  package "Marshal.Tasks" as Tasks {
    component "Scheduler, EventBus +\nTriggerMatcher, worker pool,\nexecutors, NotificationRouter" as TaskParts
    component "Cronos" <<nuget>>
  }

  package "Marshal.Integrations.*" as Integrations {
    component "HomeAssistant (REST, websocket,\nMCP, calendar v1), Moonraker,\nMail, FreshRss, Notes" as IntParts
    component "MailKit" <<nuget>>
    component "Google.Apis.Gmail.v1 (later)\nMicrosoft.Graph (later)" <<nuget>>
    component "SmartReader" <<nuget>>
    component "SkiaSharp" <<nuget>>
    component "Microsoft.Extensions\n.Http.Resilience" <<nuget>>
  }

  package "Marshal.Data" as Data {
    component "DbContext + migrations,\nowner-scoped query filters" as DataParts
    component "EF Core Sqlite\n+ NamingConventions\n+ sqlite-vec" <<nuget>>
    component "AspNetCore.DataProtection" <<nuget>>
  }

  package "Marshal.Abstractions" as Abstractions {
    component "Small interfaces, Result / Result<T>,\nstrongly typed ids, execution context" as AbsParts
    component "Microsoft.Extensions.AI\n.Abstractions" <<nuget>>
  }
}

package "Separate services" {
  component "Marshal.ExecutorHost\n(coding sandbox service)" as ExecutorHost
}

package "tests/" {
  component "Marshal.*.Tests" as Tests
  component "Marshal.Testing\n(shared fakes: FakeChatClient,\nFakeEmbeddingGenerator, FakeTool)" as Testing
  component "xunit.v3, Testcontainers,\nTimeProvider.Testing,\nMvc.Testing,\nTesting.Extensions.CodeCoverage" <<nuget>>
}

' ------------------------------------------------------------------
' Project references (arrow = "depends on")
HaComponent ..> Api : HTTP (conversation:write)
Web ..> Api : HTTP + live updates
Companion ..> Api : via HA events\n(nonce-verified)

Api --> Core
Api --> Memory
Api --> Tasks
Api --> Integrations
Api --> Data
Api --> Abstractions

Core --> Abstractions
Core --> Data
Memory --> Abstractions
Memory --> Data
Tasks --> Core
Tasks --> Abstractions
Tasks --> Data
Integrations --> Abstractions
Integrations --> Data
Data --> Abstractions

Tasks ..> ExecutorHost : HTTP (scoped token)
ExecutorHost ..> Api : callbacks\n(per-task token)

Tests --> Testing
Testing --> Abstractions
Tests --> Api
Tests --> Core
Tests --> Data

note bottom of Abstractions
  Only interfaces, value types and Result
  (references only the MEAI abstractions).
  Feature projects depend on Abstractions and,
  where they persist data, on Marshal.Data.
  Marshal.Api is the composition root and wires
  the implementations; Marshal.Tasks -> Marshal.Core
  runs headless agent loops. Provider SDKs (Ollama,
  Anthropic, OpenAI-compatible) are referenced only
  by the host.
end note

@enduml
