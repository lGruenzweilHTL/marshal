@startuml request-flow
' Marshal — Voice turn request flow
'
' KEEP UP TO DATE: this diagram must match the conversation turn path
' (ha/ custom component → POST /api/v1/conversation/turns → agent loop → SSE).
' Update it in the same change that alters that path, and re-render the SVG
' (see docs/diagrams/README.md).

!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam sequence {
  ParticipantBackgroundColor #FEFEFE
  ParticipantBorderColor #555555
  LifeLineBorderColor #999999
  ArrowColor #555555
  GroupBorderColor #999999
}
hide footbox

title Marshal — Voice turn

actor "User" as User
participant "Satellite +\nHA Assist (STT / TTS)" as Assist
participant "Marshal component\n(ha/ custom_components)" as Comp
participant "Marshal.Api\n(auth, sessions)" as Api
participant "Marshal.Core\n(confirmation, agent loop,\nvisibility filter, guard)" as Core
participant "Model\n(IChatClient, fast tier)" as Model
participant "Tools\n(HA MCP, integrations)" as Tools

User -> Assist : speech
Assist -> Comp : text, language, conversation_id,\ndevice, satellite
Comp -> Api : POST /api/v1/conversation/turns\nBearer token, inputMode = voice,\nareaId, haUserId (no entity states)
Api -> Api : check scope conversation:write\nsession by (token, conversationId)\nowner pinned on first turn
Api -> Core : turn + execution context\n(owner, source, satellite, language)

alt pending action in this session
  Core -> Core : keyword match, else judge\n(see confirm-flow)
end

Core -> Core : build context\n(profile, memory, time, satellite,\narea states, output mode)
loop until reply, step limit or latency cap
  Core -> Core : visible tools for this round
  Core -> Model : messages + visible tools
  Model --> Core : text deltas / tool calls
  Core --> Api : delta events
  opt tool calls
    Core -> Core : guard each call\n(safe / confirm / deny)
    Core -> Tools : execute safe calls
    Tools --> Core : result (untrusted output wrapped, taints run)
  end
end

alt latency cap (default 8 s for voice)
  Core -> Core : continue run as background task
end

Core -> Core : record run and steps
Api --> Comp : SSE: delta ..., final\n{ speech, continueConversation, conversationId }
Comp --> Assist : response, continue_conversation
Assist --> User : spoken reply (keeps listening\nif continueConversation)
@enduml
