{
  "name": "marshal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "vite --mode preview",
    "gen:api": "dotnet run --project ../src/Marshal.Api -- --export-openapi \"$PWD/openapi/v1.json\" && npm run gen:types",
    "gen:types": "openapi-typescript openapi/v1.json -o src/api/schema.d.ts",
    "gen:tokens": "node scripts/tokens.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run gen:types && npm run typecheck && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "highlight.js": "^11.12.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.2",
    "openapi-fetch": "^0.17.0",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
