<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- App version shown in the system view; CI may override with -p:Version=... -->
    <Version>0.1.0</Version>
    <!-- The commit hash in the informational version changes AssemblyInfo on every commit, which recompiles every
         project. Debug builds leave it out; Release (the Docker images) keeps it for the system view. -->
    <IncludeSourceRevisionInInformationalVersion Condition="'$(Configuration)' == 'Debug'">false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are required on public abstractions only (STYLE_GUIDE), not on every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
