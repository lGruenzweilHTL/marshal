<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parity cases shared with the web highlighter's tests. -->
    <Content Include="..\..\web\src\artifacts\highlighting\cases.json" Link="Highlighting\cases.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The web theme, whose dark syntax colors the display pages must use. -->
    <Content Include="..\..\web\src\ui\tokens.css" Link="Highlighting\tokens.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marshal.Testing\Marshal.Testing.csproj" />
    <ProjectReference Include="..\..\src\Marshal.Artifacts\Marshal.Artifacts.csproj" />
  </ItemGroup>

</Project>
